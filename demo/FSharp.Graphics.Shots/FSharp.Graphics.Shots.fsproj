<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless driver: renders the DSL / widget gallery / CSG showcase, writing PNGs through the real pipeline.
       (The scripted session against the widget editor is a test of fsharp-wasm-ide.) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Showcase.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FSharp.Graphics.Widgets/FSharp.Graphics.Widgets.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.SceneDsl/FSharp.Graphics.SceneDsl.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Render/FSharp.Graphics.Render.fsproj" />
    <ProjectReference Include="../../src/FSharp.Graphics.Host/FSharp.Graphics.Host.fsproj" />
  </ItemGroup>
</Project>
