<Project Sdk="Microsoft.NET.Sdk">
  <!-- The scene gallery: the 13 scenes of FSharp.Graphics.Scenes (shapes … dashboard, animation, interaction, a stress test)
       on one <canvas>, drawn through runtime/gfx.js.  Compiled to WasmGC by the fsharp-wasm compiler:
         bash build/build-browser.sh
       The host files are the ones of FSharp.Graphics.Browser (linked, not copied): the surface, the text engine and the
       command sink are shared with the GUI builder; only this project's last file becomes the module's exports. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>FSharp.Graphics.Browser</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- [<Import>] and nativeOnly: the stub of FSharp.Wasm.Core -->
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="../FSharp.Graphics.Browser/Gfx.fs" />
    <Compile Include="../FSharp.Graphics.Browser/CanvasText.fs" />
    <Compile Include="../FSharp.Graphics.Browser/Emit.fs" />
    <Compile Include="../FSharp.Graphics.Browser/CanvasSink.fs" />
    <Compile Include="SceneGallery.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Graphics.Scenes/FSharp.Graphics.Scenes.fsproj" />
  </ItemGroup>
</Project>
