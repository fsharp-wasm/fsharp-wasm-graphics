<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.Scene</RootNamespace>
    <AssemblyName>FSharp.Graphics.Scene</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <IsPackable>true</IsPackable>
      <Description>The scene graph: animation, layout, resolution to absolute geometry, picking (hit testing) and routing, and the semantic tree for accessibility. Runs under .NET and as WebAssembly GC.</Description>
      <PackageTags>scene-graph;layout;hit-testing;accessibility</PackageTags>
</PropertyGroup>
  <ItemGroup>
    <Compile Include="Animation.fs" />
    <Compile Include="Scene.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Resolve.fs" />
    <Compile Include="SemanticTree.fs" />
    <Compile Include="Hit.fs" />
    <Compile Include="ActorBuilder.fs" />
    <Compile Include="Combinators.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Math/FSharp.Math.fsproj" />
    <ProjectReference Include="../FSharp.Graphics.Core/FSharp.Graphics.Core.fsproj" />
    <ProjectReference Include="../FSharp.Graphics.Primitives/FSharp.Graphics.Primitives.fsproj" />
  </ItemGroup>
</Project>
