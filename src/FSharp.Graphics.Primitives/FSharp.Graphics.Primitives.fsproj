<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.Primitives</RootNamespace>
    <AssemblyName>FSharp.Graphics.Primitives</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <IsPackable>true</IsPackable>
      <Description>Signed-distance-field shapes, a shape cache and the draw list that renderers consume. Runs under .NET and as WebAssembly GC.</Description>
      <PackageTags>graphics;sdf</PackageTags>
</PropertyGroup>
  <ItemGroup>
    <Compile Include="ISdfShape.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="ShapeCache.fs" />
    <Compile Include="DrawList.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Math/FSharp.Math.fsproj" />
    <ProjectReference Include="../FSharp.Graphics.Core/FSharp.Graphics.Core.fsproj" />
  </ItemGroup>
</Project>
