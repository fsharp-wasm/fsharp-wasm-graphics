<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Math</RootNamespace>
    <AssemblyName>FSharp.Math</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <IsPackable>true</IsPackable>
</PropertyGroup>
  <!-- Compiled by fsharp-wasm (WasmGC) only.  FSharp.Math is the root of the dependency graph, so the portable collections of
       FSharp.Wasm.Core (Dictionary, HashSet, Queue, Stack, Map, Set: F# sources, not BCL types) are compiled once, first, and
       every project above sees them.  FSharpWasmCoreDir comes from the Directory.Build.props of this repository. -->
  <Import Project="$(FSharpWasmCoreDir)/FSharp.Wasm.Core.props" Condition="'$(FABLE_COMPILER_WASMGC)' == 'True'" />
  <ItemGroup>
    <Compile Include="Scalar.fs" />
    <Compile Include="Vec2.fs" />
    <Compile Include="Vec3.fs" />
    <Compile Include="Vec4.fs" />
    <Compile Include="Rect.fs" />
    <Compile Include="Mat3x2.fs" />
    <Compile Include="Mat4x4.fs" />
    <Compile Include="BezierCubic.fs" />
    <Compile Include="Color.fs" />
  </ItemGroup>
</Project>
