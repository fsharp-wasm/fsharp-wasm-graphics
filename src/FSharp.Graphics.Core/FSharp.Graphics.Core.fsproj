<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.Core</RootNamespace>
    <AssemblyName>FSharp.Graphics.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <IsPackable>true</IsPackable>
      <Description>The vocabulary of the scene graph: paints, strokes, shadows, corner radii and text types. Runs under .NET and as WebAssembly GC.</Description>
      <PackageTags>graphics;scene-graph</PackageTags>
</PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Paint.fs" />
    <Compile Include="Shadow.fs" />
    <Compile Include="Stroke.fs" />
    <Compile Include="CornerRadius.fs" />
    <Compile Include="TextTypes.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Math/FSharp.Math.fsproj" />
  </ItemGroup>
</Project>
