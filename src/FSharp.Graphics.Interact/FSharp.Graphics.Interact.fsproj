<Project Sdk="Microsoft.NET.Sdk">
  <!-- FSharp.Graphics.Interact: where a drag lands.  Slots (a place that things can be dropped before, after or into), the drop that a pointer position means,
       a drag as a session (press, move, release, cancel), the same drag by the keyboard (the places in reading order, an arrow key to the next) and the scrolling near an edge.  Pure geometry on FSharp.Math: no scene graph, no DOM, no canvas, so the
       widget editor (a canvas) and the newsletter designer (the DOM) use the same code.  The picking of the scene graph (Hit) and the layout it computes are what
       a canvas takes the slots from; the browser's element rectangles are where the DOM takes them from.  What is dropped, and what a drop does to the document,
       is the application's (FSharp.Wasm.Edit of fsharp-wasm-core has the operations). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Graphics.Interact</RootNamespace>
    <AssemblyName>FSharp.Graphics.Interact</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>Where a drag lands: drop slots, drag sessions, the same drag by keyboard and edge scrolling; pure geometry shared by canvas and DOM editors. Runs under .NET and as WebAssembly GC.</Description>
    <PackageTags>drag-and-drop;interaction</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Interact.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Math/FSharp.Math.fsproj" />
  </ItemGroup>
</Project>
