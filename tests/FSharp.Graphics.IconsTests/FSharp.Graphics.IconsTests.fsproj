<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of FSharp.Graphics.Icons: the reading of SVG path data, the flattening of curves and arcs, and every icon of the Lucide set as a scene.  Plain checks, no framework, so that the
       same file runs under .NET (`dotnet run`: the exit code is the number of failures) and compiles with fsharp-wasm. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FSharp.Graphics.IconsTests</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FSharp.Graphics.Icons/FSharp.Graphics.Icons.fsproj" />
  </ItemGroup>
</Project>
