<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of FSharp.Graphics.Diagrams.  Plain checks, no framework, so that the same file runs under .NET (`dotnet run`: the exit code is the number of failures) and compiles with
       fsharp-wasm.  The layout is checked against what it promises (layers follow the links, boxes do not overlap, lines leave and enter at the boxes, a graph that has a drawing without
       crossings gets one), not against a drawing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FSharp.Graphics.DiagramsTests</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FSharp.Graphics.Diagrams/FSharp.Graphics.Diagrams.fsproj" />
  </ItemGroup>
</Project>
